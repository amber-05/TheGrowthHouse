# Server-only. NEVER prefix with NEXT_PUBLIC_ and never commit the real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin area at /admin (blog, photos, videos). Set both in Vercel too.
ADMIN_PASSWORD=choose-a-long-passphrase
# At least 32 random characters, e.g. `openssl rand -base64 48`. Signs the login cookie.
ADMIN_SESSION_SECRET=
